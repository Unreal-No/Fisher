{
  "name": "fisher",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @fisher/api db:migrate",
    "db:deploy": "pnpm --filter @fisher/api db:deploy",
    "db:seed": "pnpm --filter @fisher/api db:seed",
    "db:reset": "pnpm --filter @fisher/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
