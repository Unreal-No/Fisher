# ===== Database =====
DATABASE_URL=postgresql://fisher:fisher@localhost:5432/fisher_dev
TEST_DATABASE_URL=postgresql://fisher:fisher@localhost:5432/fisher_test

# ===== API =====
NODE_ENV=development
PORT=3000
# comma-separated origins allowed for CORS (web dev server)
CORS_ORIGINS=http://localhost:5173
# session lifetime (hours, sliding) and absolute max (days)
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# set true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
# Key for secrets at rest (2FA). Required in production: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Previous keys (comma-separated) during key rotation — see README "หมุนกุญแจเข้ารหัส"
APP_ENCRYPTION_KEYS_OLD=
# GPS over MQTT (optional): devices publish to <prefix>/<generic|osmand|ais>/<device identifier>
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=fisher/gps
# Outgoing email: without SMTP_URL emails are simulated (kept in the outbox, not sent). e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Fisher ERP <no-reply@example.com>

# ===== File storage =====
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# ===== Seed (dev only) =====
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
