// Fishery ERP – Phase 1 schema (auth/RBAC, fleet, HR, trips, catch, GPS base, system).
// Conventions: snake_case tables/columns, UUIDv7 ids, money Decimal(14,2), weight kg Decimal(12,3),
// date-only fields @db.Date, soft delete via deleted_at on master data, trips/catch are never hard-deleted.
// Enum values must match packages/shared/src/enums.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ======================= ENUMS =======================
enum VesselStatus {
  AT_PORT
  AT_SEA
  MAINTENANCE
  INACTIVE
}

enum VesselDocType {
  REGISTRATION
  FISHING_LICENSE
  PORT_IN_OUT
  INSURANCE
  SAFETY_CERT
  RADIO_LICENSE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum EmployeePosition {
  CAPTAIN
  ENGINEER
  DECKHAND
  COOK
  FISH_HANDLER
  OFFICE
  MANAGER
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum PayType {
  MONTHLY
  DAILY
  PER_TRIP
  REVENUE_SHARE
  CATCH_BASED
}

enum DocAppliesTo {
  ALL
  THAI
  FOREIGN
}

enum EmpDocStatus {
  ACTIVE
  REPLACED
  CANCELLED
}

enum TripStatus {
  DRAFT
  PREPARING
  DEPARTED
  AT_SEA
  RETURNING
  ARRIVED
  PENDING_SETTLEMENT
  CLOSED
  CANCELLED
}

enum FuelType {
  DIESEL
  DIESEL_B7
  DIESEL_B10
  BENZINE
  OTHER
}

enum Measurement {
  MEASURED
  ESTIMATED
}

enum SupplyCategory {
  FOOD
  WATER
  ICE
  NET
  ROPE
  FISHING_GEAR
  SPARE_PART
  SAFETY
  MAINTENANCE
  OTHER
}

enum TripExpenseCategory {
  PORT_FEE
  ICE
  FOOD
  REPAIR
  LABOR
  UNLOADING
  OTHER
}

enum IncidentType {
  ACCIDENT
  INJURY
  EQUIPMENT_FAILURE
  WEATHER
  LOST_GEAR
  INSPECTION
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum SpeciesCategory {
  FISH
  SQUID
  SHRIMP
  CRAB
  SHELLFISH
  TRASH_FISH
  OTHER
}

enum StorageType {
  ICE
  CHILLED
  FROZEN
  LIVE
  DRIED
  OTHER
}

enum CatchQuality {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum LossType {
  SPOILAGE
  DAMAGE
  WEIGH_DIFF
  OTHER
}

enum GpsSource {
  DEDICATED
  MOBILE
  AIS
}

enum GeofenceType {
  CIRCLE
  POLYGON
}

enum GeofenceAlert {
  ENTER
  EXIT
  BOTH
}

enum FuelTxnType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ORDERED
}

enum PoStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockMoveType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum SalesStatus {
  DRAFT
  CONFIRMED
  VOID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
  OTHER
}

enum MaintCategory {
  ENGINE
  HULL
  ELECTRICAL
  HYDRAULIC
  SAFETY
  FISHING_GEAR
  REFRIGERATION
  DOCKING
  OTHER
}

enum MaintType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  DOCKING
}

enum MaintStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EngineHourSource {
  MANUAL
  TRIP_DEPARTURE
  TRIP_ARRIVAL
  MAINTENANCE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FileSensitivity {
  INTERNAL
  CONFIDENTIAL
  PERSONAL
}

// ======================= AUTH / RBAC =======================
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  username           String    @unique
  email              String?   @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  employeeId         String?   @unique @map("employee_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  employee      Employee?      @relation(fields: [employeeId], references: [id])
  roles         UserRole[]
  vessels       UserVessel[]
  sessions      Session[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique
  module      String
  action      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Data scope: if a user has rows here, vessel-bound data is limited to these vessels. No rows = all vessels.
model UserVessel {
  userId   String @map("user_id") @db.Uuid
  vesselId String @map("vessel_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vessel   Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@id([userId, vesselId])
  @@map("user_vessels")
}

/// id = sha256(session token). Raw token only lives in the httpOnly cookie.
model Session {
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  csrfToken  String   @map("csrf_token")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ======================= FILES =======================
model FileObject {
  id           String          @id @default(uuid(7)) @db.Uuid
  storageKey   String          @unique @map("storage_key")
  fileName     String          @map("file_name")
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  sha256       String
  sensitivity  FileSensitivity @default(INTERNAL)
  uploadedById String?         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz

  @@map("files")
}

// ======================= FLEET =======================
model Vessel {
  id                 String       @id @default(uuid(7)) @db.Uuid
  code               String       @unique
  name               String
  registrationNo     String       @unique @map("registration_no")
  vesselType         String       @map("vessel_type")
  lengthM            Decimal?     @map("length_m") @db.Decimal(8, 2)
  widthM             Decimal?     @map("width_m") @db.Decimal(8, 2)
  grossTonnage       Decimal?     @map("gross_tonnage") @db.Decimal(10, 2)
  netTonnage         Decimal?     @map("net_tonnage") @db.Decimal(10, 2)
  hullMaterial       String?      @map("hull_material")
  buildYear          Int?         @map("build_year")
  homePort           String?      @map("home_port")
  engineMake         String?      @map("engine_make")
  engineModel        String?      @map("engine_model")
  engineSerialNo     String?      @map("engine_serial_no")
  enginePowerHp      Decimal?     @map("engine_power_hp") @db.Decimal(10, 2)
  fuelTankCapacityL  Decimal?     @map("fuel_tank_capacity_l") @db.Decimal(12, 2)
  ownerName          String?      @map("owner_name")
  ownerTaxId         String?      @map("owner_tax_id")
  captainId          String?      @map("captain_id") @db.Uuid
  radioCallSign      String?      @map("radio_call_sign")
  mmsi               String?      @unique
  commEquipment      String?      @map("comm_equipment")
  licenseNo          String?      @map("license_no")
  licenseExpiry      DateTime?    @map("license_expiry") @db.Date
  registrationExpiry DateTime?    @map("registration_expiry") @db.Date
  status             VesselStatus @default(AT_PORT)
  photoFileId        String?      @map("photo_file_id") @db.Uuid
  notes              String?
  createdById        String?      @map("created_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz

  captain           Employee?          @relation("VesselCaptain", fields: [captainId], references: [id])
  documents         VesselDocument[]
  trips             FishingTrip[]
  catches           CatchRecord[]
  assignments       VesselAssignment[]
  crewEmployees     Employee[]         @relation("EmployeeCurrentVessel")
  gpsDevices        GpsDevice[]
  gpsPositions      GpsPosition[]
  userScopes        UserVessel[]
  geofenceEvents    GeofenceEvent[]
  fuelTxns          FuelTransaction[]
  stockMovements    StockMovement[]
  maintenancePlans  MaintenancePlan[]
  engineHourLogs    EngineHourLog[]
  maintenanceOrders MaintenanceOrder[]

  @@index([status])
  @@index([deletedAt])
  @@map("vessels")
}

model VesselDocument {
  id          String        @id @default(uuid(7)) @db.Uuid
  vesselId    String        @map("vessel_id") @db.Uuid
  docType     VesselDocType @map("doc_type")
  docNo       String?       @map("doc_no")
  issueDate   DateTime?     @map("issue_date") @db.Date
  expiryDate  DateTime?     @map("expiry_date") @db.Date
  fileId      String?       @map("file_id") @db.Uuid
  notes       String?
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz
  vessel      Vessel        @relation(fields: [vesselId], references: [id])

  @@index([vesselId])
  @@index([expiryDate])
  @@map("vessel_documents")
}

// ======================= HR =======================
model Employee {
  id                    String           @id @default(uuid(7)) @db.Uuid
  code                  String           @unique
  firstName             String           @map("first_name")
  lastName              String           @map("last_name")
  firstNameEn           String?          @map("first_name_en")
  lastNameEn            String?          @map("last_name_en")
  nickname              String?
  dateOfBirth           DateTime?        @map("date_of_birth") @db.Date
  nationality           String
  gender                Gender           @default(UNSPECIFIED)
  phone                 String?
  address               String?
  emergencyContactName  String?          @map("emergency_contact_name")
  emergencyContactPhone String?          @map("emergency_contact_phone")
  /// PDPA: personal identifier – masked unless employee.sensitive
  nationalIdNo          String?          @map("national_id_no")
  startDate             DateTime         @map("start_date") @db.Date
  endDate               DateTime?        @map("end_date") @db.Date
  status                EmployeeStatus   @default(ACTIVE)
  position              EmployeePosition
  currentVesselId       String?          @map("current_vessel_id") @db.Uuid
  payType               PayType          @default(MONTHLY) @map("pay_type")
  baseRate              Decimal?         @map("base_rate") @db.Decimal(14, 2)
  bankName              String?          @map("bank_name")
  /// PDPA: masked unless employee.sensitive
  bankAccountNo         String?          @map("bank_account_no")
  photoFileId           String?          @map("photo_file_id") @db.Uuid
  notes                 String?
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz

  currentVessel Vessel?             @relation("EmployeeCurrentVessel", fields: [currentVesselId], references: [id])
  captainOf     Vessel[]            @relation("VesselCaptain")
  documents     EmployeeDocument[]
  history       EmploymentHistory[]
  assignments   VesselAssignment[]
  tripCrew      TripCrew[]
  captainTrips  FishingTrip[]       @relation("TripCaptain")
  user          User?

  @@index([status])
  @@index([currentVesselId])
  @@index([nationality])
  @@index([deletedAt])
  @@map("employees")
}

/// Configurable document checklist (passport, work permit, seaman book…). Reminders are business rules, not legal advice.
model DocumentType {
  id             String             @id @default(uuid(7)) @db.Uuid
  code           String             @unique
  nameTh         String             @map("name_th")
  nameEn         String?            @map("name_en")
  appliesTo      DocAppliesTo       @default(ALL) @map("applies_to")
  isRequired     Boolean            @default(false) @map("is_required")
  requiresExpiry Boolean            @default(true) @map("requires_expiry")
  isActive       Boolean            @default(true) @map("is_active")
  sortOrder      Int                @default(0) @map("sort_order")
  documents      EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDocument {
  id             String       @id @default(uuid(7)) @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  documentTypeId String       @map("document_type_id") @db.Uuid
  /// PDPA: masked unless employee.sensitive
  documentNo     String?      @map("document_no")
  issueDate      DateTime?    @map("issue_date") @db.Date
  expiryDate     DateTime?    @map("expiry_date") @db.Date
  issuedBy       String?      @map("issued_by")
  fileId         String?      @map("file_id") @db.Uuid
  status         EmpDocStatus @default(ACTIVE)
  /// renewal chain: the document that replaced this one
  replacedById   String?      @unique @map("replaced_by_id") @db.Uuid
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  employee     Employee          @relation(fields: [employeeId], references: [id])
  documentType DocumentType      @relation(fields: [documentTypeId], references: [id])
  replacedBy   EmployeeDocument? @relation("DocRenewal", fields: [replacedById], references: [id])
  replaces     EmployeeDocument? @relation("DocRenewal")

  @@index([employeeId, status])
  @@index([expiryDate])
  @@map("employee_documents")
}

model EmploymentHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  eventType     String   @map("event_type") // HIRED, STATUS_CHANGE, POSITION_CHANGE, PAY_CHANGE, VESSEL_ASSIGN
  effectiveDate DateTime @map("effective_date") @db.Date
  fromValue     String?  @map("from_value")
  toValue       String?  @map("to_value")
  notes         String?
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveDate])
  @@map("employment_history")
}

/// One open assignment (end_date null) per employee – enforced by partial unique index in migration.
model VesselAssignment {
  id          String           @id @default(uuid(7)) @db.Uuid
  employeeId  String           @map("employee_id") @db.Uuid
  vesselId    String           @map("vessel_id") @db.Uuid
  position    EmployeePosition
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  notes       String?
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  employee    Employee         @relation(fields: [employeeId], references: [id])
  vessel      Vessel           @relation(fields: [vesselId], references: [id])

  @@index([employeeId])
  @@index([vesselId, endDate])
  @@map("vessel_assignments")
}

// ======================= TRIPS =======================
/// One vessel per trip. At most one trip per vessel in active statuses unless allow_concurrent (partial unique index).
model FishingTrip {
  id                         String       @id @default(uuid(7)) @db.Uuid
  tripNo                     String       @unique @map("trip_no")
  vesselId                   String       @map("vessel_id") @db.Uuid
  captainId                  String?      @map("captain_id") @db.Uuid
  status                     TripStatus   @default(DRAFT)
  plannedDepartureAt         DateTime?    @map("planned_departure_at") @db.Timestamptz
  plannedReturnAt            DateTime?    @map("planned_return_at") @db.Timestamptz
  fishingArea                String?      @map("fishing_area")
  departedAt                 DateTime?    @map("departed_at") @db.Timestamptz
  departurePort              String?      @map("departure_port")
  departureLat               Decimal?     @map("departure_lat") @db.Decimal(9, 6)
  departureLng               Decimal?     @map("departure_lng") @db.Decimal(9, 6)
  fuelAtDepartureL           Decimal?     @map("fuel_at_departure_l") @db.Decimal(12, 2)
  fuelAtDepartureMeasurement Measurement? @map("fuel_at_departure_measurement")
  engineHoursAtDeparture     Decimal?     @map("engine_hours_at_departure") @db.Decimal(10, 1)
  engineHoursAtArrival       Decimal?     @map("engine_hours_at_arrival") @db.Decimal(10, 1)
  conditionNote              String?      @map("condition_note")
  departureOverrideReason    String?      @map("departure_override_reason")
  arrivedAt                  DateTime?    @map("arrived_at") @db.Timestamptz
  arrivalPort                String?      @map("arrival_port")
  arrivalLat                 Decimal?     @map("arrival_lat") @db.Decimal(9, 6)
  arrivalLng                 Decimal?     @map("arrival_lng") @db.Decimal(9, 6)
  fuelAtArrivalL             Decimal?     @map("fuel_at_arrival_l") @db.Decimal(12, 2)
  fuelAtArrivalMeasurement   Measurement? @map("fuel_at_arrival_measurement")
  allowConcurrent            Boolean      @default(false) @map("allow_concurrent")
  concurrentReason           String?      @map("concurrent_reason")
  settlementSnapshot         Json?        @map("settlement_snapshot")
  closedAt                   DateTime?    @map("closed_at") @db.Timestamptz
  closedById                 String?      @map("closed_by_id") @db.Uuid
  cancelledAt                DateTime?    @map("cancelled_at") @db.Timestamptz
  cancelReason               String?      @map("cancel_reason")
  notes                      String?
  version                    Int          @default(1)
  createdById                String?      @map("created_by_id") @db.Uuid
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vessel        Vessel              @relation(fields: [vesselId], references: [id])
  captain       Employee?           @relation("TripCaptain", fields: [captainId], references: [id])
  crew          TripCrew[]
  fuel          TripFuel[]
  supplies      TripSupply[]
  expenses      TripExpense[]
  incidents     TripIncident[]
  statusHistory TripStatusHistory[]
  catches       CatchRecord[]
  losses        CatchLoss[]
  salesItems    SalesItem[]

  @@index([vesselId, status])
  @@index([status])
  @@index([departedAt])
  @@map("fishing_trips")
}

model TripStatusHistory {
  id          String      @id @default(uuid(7)) @db.Uuid
  tripId      String      @map("trip_id") @db.Uuid
  fromStatus  TripStatus? @map("from_status")
  toStatus    TripStatus  @map("to_status")
  note        String?
  changedById String?     @map("changed_by_id") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at") @db.Timestamptz
  trip        FishingTrip @relation(fields: [tripId], references: [id])

  @@index([tripId, changedAt])
  @@map("trip_status_history")
}

model TripCrew {
  id         String           @id @default(uuid(7)) @db.Uuid
  tripId     String           @map("trip_id") @db.Uuid
  employeeId String           @map("employee_id") @db.Uuid
  role       EmployeePosition
  /// document check result captured at departure (audit trail)
  docCheck   Json?            @map("doc_check")
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  trip       FishingTrip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([tripId, employeeId])
  @@index([employeeId])
  @@map("trip_crew")
}

model TripFuel {
  id            String           @id @default(uuid(7)) @db.Uuid
  tripId        String           @map("trip_id") @db.Uuid
  recordedAt    DateTime         @map("recorded_at") @db.Timestamptz
  fuelType      FuelType         @map("fuel_type")
  liters        Decimal          @db.Decimal(12, 2)
  pricePerLiter Decimal?         @map("price_per_liter") @db.Decimal(10, 4)
  totalCost     Decimal?         @map("total_cost") @db.Decimal(14, 2)
  supplierName  String?          @map("supplier_name")
  measurement   Measurement      @default(MEASURED)
  fileId        String?          @map("file_id") @db.Uuid
  notes         String?
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  trip          FishingTrip      @relation(fields: [tripId], references: [id])
  /// set when fuel came from a company tank (ledger-linked; cannot be deleted from the trip)
  fuelTxn       FuelTransaction?

  @@index([tripId])
  @@map("trip_fuel")
}

model TripSupply {
  id          String         @id @default(uuid(7)) @db.Uuid
  tripId      String         @map("trip_id") @db.Uuid
  category    SupplyCategory
  description String
  quantity    Decimal        @db.Decimal(12, 3)
  unit        String
  unitCost    Decimal?       @map("unit_cost") @db.Decimal(14, 4)
  totalCost   Decimal?       @map("total_cost") @db.Decimal(14, 2)
  notes       String?
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  trip        FishingTrip    @relation(fields: [tripId], references: [id])
  /// set when issued from company stock (ledger-linked; cannot be deleted from the trip)
  stockMove   StockMovement?

  @@index([tripId])
  @@map("trip_supplies")
}

model TripExpense {
  id          String              @id @default(uuid(7)) @db.Uuid
  tripId      String              @map("trip_id") @db.Uuid
  category    TripExpenseCategory
  description String
  amount      Decimal             @db.Decimal(14, 2)
  expenseDate DateTime            @map("expense_date") @db.Date
  /// operational estimate vs. confirmed amount (accounting posts confirmed only)
  isEstimate  Boolean             @default(false) @map("is_estimate")
  fileId      String?             @map("file_id") @db.Uuid
  notes       String?
  createdById String?             @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  trip        FishingTrip         @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@map("trip_expenses")
}

model TripIncident {
  id          String       @id @default(uuid(7)) @db.Uuid
  tripId      String       @map("trip_id") @db.Uuid
  occurredAt  DateTime     @map("occurred_at") @db.Timestamptz
  type        IncidentType
  severity    Severity
  description String
  lat         Decimal?     @db.Decimal(9, 6)
  lng         Decimal?     @db.Decimal(9, 6)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  trip        FishingTrip  @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@map("trip_incidents")
}

// ======================= CATCH =======================
model FishSpecies {
  id             String          @id @default(uuid(7)) @db.Uuid
  code           String          @unique
  nameTh         String          @map("name_th")
  nameEn         String?         @map("name_en")
  scientificName String?         @map("scientific_name")
  category       SpeciesCategory
  unit           String          @default("กก.")
  defaultPrice   Decimal?        @map("default_price") @db.Decimal(12, 2)
  isActive       Boolean         @default(true) @map("is_active")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  catches        CatchRecord[]
  losses         CatchLoss[]
  salesItems     SalesItem[]

  @@map("fish_species")
}

model CatchGrade {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  nameTh      String        @map("name_th")
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  catches     CatchRecord[]
  salesItems  SalesItem[]

  @@map("catch_grades")
}

/// Caught weight (NOT sold weight). Sales module links to catch/inventory lots later.
model CatchRecord {
  id              String        @id @default(uuid(7)) @db.Uuid
  tripId          String        @map("trip_id") @db.Uuid
  /// denormalised from trip for reporting; always equals trip.vessel_id
  vesselId        String        @map("vessel_id") @db.Uuid
  speciesId       String        @map("species_id") @db.Uuid
  gradeId         String?       @map("grade_id") @db.Uuid
  catchDate       DateTime      @map("catch_date") @db.Date
  weightKg        Decimal       @map("weight_kg") @db.Decimal(12, 3)
  quantity        Int?
  basketCount     Int?          @map("basket_count")
  quality         CatchQuality?
  storageType     StorageType   @default(ICE) @map("storage_type")
  notes           String?
  /// offline idempotency key from client
  clientRequestId String?       @unique @map("client_request_id") @db.Uuid
  version         Int           @default(1)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz
  voidReason      String?       @map("void_reason")
  voidedById      String?       @map("voided_by_id") @db.Uuid
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  trip        FishingTrip       @relation(fields: [tripId], references: [id])
  vessel      Vessel            @relation(fields: [vesselId], references: [id])
  species     FishSpecies       @relation(fields: [speciesId], references: [id])
  grade       CatchGrade?       @relation(fields: [gradeId], references: [id])
  adjustments CatchAdjustment[]
  losses      CatchLoss[]

  @@index([tripId])
  @@index([vesselId, catchDate])
  @@index([speciesId, catchDate])
  @@index([catchDate])
  @@map("catch_records")
}

model CatchAdjustment {
  id            String      @id @default(uuid(7)) @db.Uuid
  catchRecordId String      @map("catch_record_id") @db.Uuid
  changes       Json // { field: { from, to } }
  reason        String
  adjustedById  String?     @map("adjusted_by_id") @db.Uuid
  adjustedAt    DateTime    @default(now()) @map("adjusted_at") @db.Timestamptz
  catchRecord   CatchRecord @relation(fields: [catchRecordId], references: [id])

  @@index([catchRecordId])
  @@map("catch_adjustments")
}

model CatchLoss {
  id            String       @id @default(uuid(7)) @db.Uuid
  tripId        String       @map("trip_id") @db.Uuid
  catchRecordId String?      @map("catch_record_id") @db.Uuid
  speciesId     String       @map("species_id") @db.Uuid
  lossType      LossType     @map("loss_type")
  weightKg      Decimal      @map("weight_kg") @db.Decimal(12, 3)
  reason        String
  recordedAt    DateTime     @map("recorded_at") @db.Timestamptz
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  trip          FishingTrip  @relation(fields: [tripId], references: [id])
  catchRecord   CatchRecord? @relation(fields: [catchRecordId], references: [id])
  species       FishSpecies  @relation(fields: [speciesId], references: [id])

  @@index([tripId])
  @@map("catch_losses")
}

// ======================= GPS (ingestion implemented in Phase 2) =======================
model GpsDevice {
  id         String        @id @default(uuid(7)) @db.Uuid
  vesselId   String?       @map("vessel_id") @db.Uuid
  source     GpsSource
  identifier String        @unique // IMEI / MMSI / app device id
  name       String?
  apiKeyHash String?       @unique @map("api_key_hash")
  isActive   Boolean       @default(true) @map("is_active")
  lastSeenAt DateTime?     @map("last_seen_at") @db.Timestamptz
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  vessel     Vessel?       @relation(fields: [vesselId], references: [id])
  positions  GpsPosition[]

  @@map("gps_devices")
}

model GpsPosition {
  id            BigInt     @id @default(autoincrement())
  vesselId      String     @map("vessel_id") @db.Uuid
  deviceId      String?    @map("device_id") @db.Uuid
  recordedAt    DateTime   @map("recorded_at") @db.Timestamptz
  receivedAt    DateTime   @default(now()) @map("received_at") @db.Timestamptz
  lat           Decimal    @db.Decimal(9, 6)
  lng           Decimal    @db.Decimal(9, 6)
  speedKnots    Decimal?   @map("speed_knots") @db.Decimal(6, 2)
  headingDeg    Decimal?   @map("heading_deg") @db.Decimal(5, 2)
  signalQuality Int?       @map("signal_quality")
  source        GpsSource
  isDemo        Boolean    @default(false) @map("is_demo")
  vessel        Vessel     @relation(fields: [vesselId], references: [id])
  device        GpsDevice? @relation(fields: [deviceId], references: [id])

  @@unique([vesselId, deviceId, recordedAt])
  @@index([vesselId, recordedAt])
  @@map("gps_positions")
}

model Geofence {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  type        GeofenceType
  centerLat   Decimal?        @map("center_lat") @db.Decimal(9, 6)
  centerLng   Decimal?        @map("center_lng") @db.Decimal(9, 6)
  radiusKm    Decimal?        @map("radius_km") @db.Decimal(10, 3)
  /// [[lat, lng], ...] for POLYGON
  polygon     Json?
  alertOn     GeofenceAlert   @default(BOTH) @map("alert_on")
  isActive    Boolean         @default(true) @map("is_active")
  notes       String?
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  events      GeofenceEvent[]

  @@map("geofences")
}

model GeofenceEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  geofenceId String   @map("geofence_id") @db.Uuid
  vesselId   String   @map("vessel_id") @db.Uuid
  eventType  String   @map("event_type") // ENTER | EXIT
  at         DateTime @db.Timestamptz
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  isDemo     Boolean  @default(false) @map("is_demo")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  geofence   Geofence @relation(fields: [geofenceId], references: [id])
  vessel     Vessel   @relation(fields: [vesselId], references: [id])

  @@index([vesselId, at])
  @@index([geofenceId, at])
  @@map("geofence_events")
}

// ======================= FUEL (company tanks, moving-average cost) =======================
model FuelTank {
  id           String            @id @default(uuid(7)) @db.Uuid
  code         String            @unique
  name         String
  location     String?
  fuelType     FuelType          @map("fuel_type")
  capacityL    Decimal?          @map("capacity_l") @db.Decimal(14, 2)
  /// maintained transactionally from fuel_transactions (row-locked)
  balanceL     Decimal           @default(0) @map("balance_l") @db.Decimal(14, 2)
  avgCost      Decimal           @default(0) @map("avg_cost") @db.Decimal(12, 4)
  isActive     Boolean           @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  transactions FuelTransaction[]

  @@map("fuel_tanks")
}

/// Immutable ledger: corrections are ADJUSTMENT rows, never edits/deletes.
model FuelTransaction {
  id             String       @id @default(uuid(7)) @db.Uuid
  txnNo          String       @unique @map("txn_no")
  tankId         String       @map("tank_id") @db.Uuid
  type           FuelTxnType
  txnDate        DateTime     @map("txn_date") @db.Timestamptz
  /// signed: + into tank, - out of tank
  liters         Decimal      @db.Decimal(14, 2)
  unitCost       Decimal      @map("unit_cost") @db.Decimal(12, 4)
  /// signed, = liters * unit_cost
  totalCost      Decimal      @map("total_cost") @db.Decimal(14, 2)
  balanceAfterL  Decimal      @map("balance_after_l") @db.Decimal(14, 2)
  avgCostAfter   Decimal      @map("avg_cost_after") @db.Decimal(12, 4)
  vesselId       String?      @map("vessel_id") @db.Uuid
  tripId         String?      @map("trip_id") @db.Uuid
  tripFuelId     String?      @unique @map("trip_fuel_id") @db.Uuid
  supplierName   String?      @map("supplier_name")
  docNo          String?      @map("doc_no")
  measurement    Measurement?
  overrideReason String?      @map("override_reason")
  fileId         String?      @map("file_id") @db.Uuid
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  tank           FuelTank     @relation(fields: [tankId], references: [id])
  vessel         Vessel?      @relation(fields: [vesselId], references: [id])
  tripFuel       TripFuel?    @relation(fields: [tripFuelId], references: [id], onDelete: Restrict)

  @@index([tankId, txnDate])
  @@index([vesselId, txnDate])
  @@map("fuel_transactions")
}

// ======================= SYSTEM =======================
model Notification {
  id         String               @id @default(uuid(7)) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  type       String // DOC_EXPIRING, DOC_EXPIRED, VESSEL_LICENSE_EXPIRING, ...
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String
  link       String?
  entityType String?              @map("entity_type")
  entityId   String?              @map("entity_id")
  /// prevents duplicate reminders for the same threshold
  dedupeKey  String               @map("dedupe_key")
  readAt     DateTime?            @map("read_at") @db.Timestamptz
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz
  userId     String?  @map("user_id") @db.Uuid
  username   String?
  action     String // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGIN_FAILED, LOGOUT, VIEW_SENSITIVE, OVERRIDE ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  note       String?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")

  @@index([entityType, entityId])
  @@index([userId, at])
  @@index([at])
  @@map("audit_logs")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

/// Gap-free running numbers per key/period (TRP-2569-0001, EMP-00001 …)
model DocSequence {
  key       String
  period    String
  lastValue Int    @default(0) @map("last_value")

  @@id([key, period])
  @@map("doc_sequences")
}

// ======================= PURCHASING / INVENTORY =======================
model Supplier {
  id                String             @id @default(uuid(7)) @db.Uuid
  code              String             @unique
  name              String
  taxId             String?            @map("tax_id")
  branch            String?
  contactName       String?            @map("contact_name")
  phone             String?
  email             String?
  address           String?
  paymentTermDays   Int?               @map("payment_term_days")
  bankName          String?            @map("bank_name")
  bankAccountNo     String?            @map("bank_account_no")
  isActive          Boolean            @default(true) @map("is_active")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz
  orders            PurchaseOrder[]
  maintenanceOrders MaintenanceOrder[]

  @@map("suppliers")
}

model Warehouse {
  id        String          @id @default(uuid(7)) @db.Uuid
  code      String          @unique
  name      String
  location  String?
  isActive  Boolean         @default(true) @map("is_active")
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  balances  StockBalance[]
  movements StockMovement[]

  @@map("warehouses")
}

model InventoryItem {
  id        String          @id @default(uuid(7)) @db.Uuid
  code      String          @unique
  name      String
  category  SupplyCategory
  unit      String
  minStock  Decimal?        @map("min_stock") @db.Decimal(14, 3)
  isActive  Boolean         @default(true) @map("is_active")
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz
  balances  StockBalance[]
  movements StockMovement[]

  @@index([category])
  @@map("inventory_items")
}

/// Maintained in the same transaction as stock_movements (row locked FOR UPDATE). Moving-average cost per warehouse+item.
model StockBalance {
  warehouseId String        @map("warehouse_id") @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  quantity    Decimal       @default(0) @db.Decimal(14, 3)
  avgCost     Decimal       @default(0) @map("avg_cost") @db.Decimal(14, 4)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@id([warehouseId, itemId])
  @@index([itemId])
  @@map("stock_balances")
}

/// Immutable stock ledger. Corrections are ADJUSTMENT rows.
model StockMovement {
  id             String        @id @default(uuid(7)) @db.Uuid
  moveNo         String        @unique @map("move_no")
  type           StockMoveType
  movedAt        DateTime      @map("moved_at") @db.Timestamptz
  warehouseId    String        @map("warehouse_id") @db.Uuid
  itemId         String        @map("item_id") @db.Uuid
  /// signed: + in, - out
  quantity       Decimal       @db.Decimal(14, 3)
  unitCost       Decimal       @map("unit_cost") @db.Decimal(14, 4)
  totalCost      Decimal       @map("total_cost") @db.Decimal(14, 2)
  balanceAfter   Decimal       @map("balance_after") @db.Decimal(14, 3)
  avgCostAfter   Decimal       @map("avg_cost_after") @db.Decimal(14, 4)
  /// GR | ISSUE | TRANSFER | ADJUSTMENT | MANUAL
  refType        String        @map("ref_type")
  refId          String?       @map("ref_id") @db.Uuid
  transferPairId String?       @map("transfer_pair_id") @db.Uuid
  vesselId       String?       @map("vessel_id") @db.Uuid
  tripId         String?       @map("trip_id") @db.Uuid
  tripSupplyId   String?       @unique @map("trip_supply_id") @db.Uuid
  overrideReason String?       @map("override_reason")
  notes          String?
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  item           InventoryItem @relation(fields: [itemId], references: [id])
  vessel         Vessel?       @relation(fields: [vesselId], references: [id])
  tripSupply     TripSupply?   @relation(fields: [tripSupplyId], references: [id], onDelete: Restrict)

  @@index([itemId, movedAt])
  @@index([warehouseId, movedAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model PurchaseRequest {
  id            String                @id @default(uuid(7)) @db.Uuid
  prNo          String                @unique @map("pr_no")
  status        PrStatus              @default(DRAFT)
  neededBy      DateTime?             @map("needed_by") @db.Date
  vesselId      String?               @map("vessel_id") @db.Uuid
  tripId        String?               @map("trip_id") @db.Uuid
  notes         String?
  requestedById String?               @map("requested_by_id") @db.Uuid
  submittedAt   DateTime?             @map("submitted_at") @db.Timestamptz
  decidedById   String?               @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz
  decisionNote  String?               @map("decision_note")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  items         PurchaseRequestItem[]
  orders        PurchaseOrder[]

  @@index([status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  prId        String          @map("pr_id") @db.Uuid
  itemId      String?         @map("item_id") @db.Uuid
  description String
  quantity    Decimal         @db.Decimal(14, 3)
  unit        String
  estUnitCost Decimal?        @map("est_unit_cost") @db.Decimal(14, 4)
  notes       String?
  pr          PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id           String              @id @default(uuid(7)) @db.Uuid
  poNo         String              @unique @map("po_no")
  status       PoStatus            @default(DRAFT)
  supplierId   String              @map("supplier_id") @db.Uuid
  prId         String?             @map("pr_id") @db.Uuid
  orderDate    DateTime            @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  /// default receiving warehouse for stock lines
  warehouseId  String              @map("warehouse_id") @db.Uuid
  /// direct-to-vessel purchase: non-stock lines are booked as trip supplies on receipt
  vesselId     String?             @map("vessel_id") @db.Uuid
  tripId       String?             @map("trip_id") @db.Uuid
  subtotal     Decimal             @db.Decimal(14, 2)
  discount     Decimal             @default(0) @db.Decimal(14, 2)
  vatRate      Decimal             @default(7) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount    Decimal             @map("vat_amount") @db.Decimal(14, 2)
  total        Decimal             @db.Decimal(14, 2)
  notes        String?
  approvedById String?             @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz
  closeReason  String?             @map("close_reason")
  version      Int                 @default(1)
  createdById  String?             @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  pr           PurchaseRequest?    @relation(fields: [prId], references: [id])
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]

  @@index([status])
  @@index([supplierId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  poId        String             @map("po_id") @db.Uuid
  itemId      String?            @map("item_id") @db.Uuid
  category    SupplyCategory     @default(OTHER)
  description String
  quantity    Decimal            @db.Decimal(14, 3)
  unit        String
  unitPrice   Decimal            @map("unit_price") @db.Decimal(14, 4)
  lineTotal   Decimal            @map("line_total") @db.Decimal(14, 2)
  receivedQty Decimal            @default(0) @map("received_qty") @db.Decimal(14, 3)
  po          PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  receipts    GoodsReceiptItem[]

  @@index([poId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                String             @id @default(uuid(7)) @db.Uuid
  grNo              String             @unique @map("gr_no")
  poId              String             @map("po_id") @db.Uuid
  warehouseId       String             @map("warehouse_id") @db.Uuid
  receivedAt        DateTime           @map("received_at") @db.Timestamptz
  supplierInvoiceNo String?            @map("supplier_invoice_no")
  fileId            String?            @map("file_id") @db.Uuid
  notes             String?
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  po                PurchaseOrder      @relation(fields: [poId], references: [id])
  items             GoodsReceiptItem[]

  @@index([poId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String            @id @default(uuid(7)) @db.Uuid
  grId            String            @map("gr_id") @db.Uuid
  poItemId        String            @map("po_item_id") @db.Uuid
  quantity        Decimal           @db.Decimal(14, 3)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(14, 4)
  lineTotal       Decimal           @map("line_total") @db.Decimal(14, 2)
  stockMovementId String?           @unique @map("stock_movement_id") @db.Uuid
  tripSupplyId    String?           @unique @map("trip_supply_id") @db.Uuid
  gr              GoodsReceipt      @relation(fields: [grId], references: [id], onDelete: Cascade)
  poItem          PurchaseOrderItem @relation(fields: [poItemId], references: [id])

  @@map("goods_receipt_items")
}

// ======================= SALES =======================
model Customer {
  id             String         @id @default(uuid(7)) @db.Uuid
  code           String         @unique
  name           String
  taxId          String?        @map("tax_id")
  branch         String?
  contactName    String?        @map("contact_name")
  phone          String?
  email          String?
  address        String?
  creditTermDays Int?           @map("credit_term_days")
  isActive       Boolean        @default(true) @map("is_active")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  invoices       SalesInvoice[]
  payments       SalesPayment[]

  @@map("customers")
}

/// DRAFT = sales order; CONFIRMED = invoice (lots consumed); VOID = cancelled invoice (no active payments).
model SalesInvoice {
  id             String         @id @default(uuid(7)) @db.Uuid
  orderNo        String         @unique @map("order_no")
  invoiceNo      String?        @unique @map("invoice_no")
  status         SalesStatus    @default(DRAFT)
  customerId     String         @map("customer_id") @db.Uuid
  invoiceDate    DateTime       @map("invoice_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  subtotal       Decimal        @db.Decimal(14, 2)
  discount       Decimal        @default(0) @db.Decimal(14, 2)
  /// charged to customer (transport, ice…) — not fish revenue
  additionalCost Decimal        @default(0) @map("additional_cost") @db.Decimal(14, 2)
  vatRate        Decimal        @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal        @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  /// maintained with payments / credit notes (invoice row locked)
  paidAmount     Decimal        @default(0) @map("paid_amount") @db.Decimal(14, 2)
  creditedAmount Decimal        @default(0) @map("credited_amount") @db.Decimal(14, 2)
  notes          String?
  confirmedAt    DateTime?      @map("confirmed_at") @db.Timestamptz
  confirmedById  String?        @map("confirmed_by_id") @db.Uuid
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz
  voidReason     String?        @map("void_reason")
  version        Int            @default(1)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  customer       Customer       @relation(fields: [customerId], references: [id])
  items          SalesItem[]
  payments       SalesPayment[]
  returns        SalesReturn[]

  @@index([status, invoiceDate])
  @@index([customerId, invoiceDate])
  @@map("sales_invoices")
}

/// Line sold from a lot = trip × species × grade (traceability catch → sale).
model SalesItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  invoiceId      String            @map("invoice_id") @db.Uuid
  tripId         String            @map("trip_id") @db.Uuid
  vesselId       String            @map("vessel_id") @db.Uuid
  speciesId      String            @map("species_id") @db.Uuid
  gradeId        String?           @map("grade_id") @db.Uuid
  description    String
  weightKg       Decimal           @map("weight_kg") @db.Decimal(12, 3)
  quantity       Int?
  unitPrice      Decimal           @map("unit_price") @db.Decimal(12, 4)
  lineTotal      Decimal           @map("line_total") @db.Decimal(14, 2)
  /// header discount allocated pro-rata (revenue = line_total - discount_share - returned_amount)
  discountShare  Decimal           @default(0) @map("discount_share") @db.Decimal(14, 2)
  returnedKg     Decimal           @default(0) @map("returned_kg") @db.Decimal(12, 3)
  returnedAmount Decimal           @default(0) @map("returned_amount") @db.Decimal(14, 2)
  invoice        SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  trip           FishingTrip       @relation(fields: [tripId], references: [id])
  species        FishSpecies       @relation(fields: [speciesId], references: [id])
  grade          CatchGrade?       @relation(fields: [gradeId], references: [id])
  returns        SalesReturnItem[]

  @@index([invoiceId])
  @@index([tripId, speciesId, gradeId])
  @@map("sales_items")
}

model SalesPayment {
  id          String        @id @default(uuid(7)) @db.Uuid
  receiptNo   String        @unique @map("receipt_no")
  invoiceId   String        @map("invoice_id") @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  paidAt      DateTime      @map("paid_at") @db.Timestamptz
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  reference   String?
  notes       String?
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz
  voidReason  String?       @map("void_reason")
  voidedById  String?       @map("voided_by_id") @db.Uuid
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  invoice     SalesInvoice  @relation(fields: [invoiceId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])

  @@index([invoiceId])
  @@index([customerId, paidAt])
  @@map("sales_payments")
}

/// Credit note. Returned fish is not restocked (normally spoiled) — it only reduces the receivable/revenue.
model SalesReturn {
  id           String            @id @default(uuid(7)) @db.Uuid
  creditNoteNo String            @unique @map("credit_note_no")
  invoiceId    String            @map("invoice_id") @db.Uuid
  returnDate   DateTime          @map("return_date") @db.Date
  reason       String
  amount       Decimal           @db.Decimal(14, 2)
  createdById  String?           @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  invoice      SalesInvoice      @relation(fields: [invoiceId], references: [id])
  items        SalesReturnItem[]

  @@index([invoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  returnId    String      @map("return_id") @db.Uuid
  salesItemId String      @map("sales_item_id") @db.Uuid
  weightKg    Decimal     @map("weight_kg") @db.Decimal(12, 3)
  amount      Decimal     @db.Decimal(14, 2)
  return      SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  salesItem   SalesItem   @relation(fields: [salesItemId], references: [id])

  @@map("sales_return_items")
}

// ======================= MAINTENANCE =======================
model MaintenancePlan {
  id                  String             @id @default(uuid(7)) @db.Uuid
  vesselId            String             @map("vessel_id") @db.Uuid
  name                String
  category            MaintCategory
  intervalDays        Int?               @map("interval_days")
  intervalEngineHours Int?               @map("interval_engine_hours")
  lastDoneAt          DateTime?          @map("last_done_at") @db.Date
  lastDoneEngineHours Decimal?           @map("last_done_engine_hours") @db.Decimal(10, 1)
  isActive            Boolean            @default(true) @map("is_active")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  vessel              Vessel             @relation(fields: [vesselId], references: [id])
  orders              MaintenanceOrder[]

  @@index([vesselId])
  @@map("maintenance_plans")
}

/// Engine hour meter readings (manual, from trips, from maintenance). Readings must not go backwards unless marked as a meter reset.
model EngineHourLog {
  id          String           @id @default(uuid(7)) @db.Uuid
  vesselId    String           @map("vessel_id") @db.Uuid
  recordedAt  DateTime         @map("recorded_at") @db.Timestamptz
  hours       Decimal          @db.Decimal(10, 1)
  source      EngineHourSource @default(MANUAL)
  isReset     Boolean          @default(false) @map("is_reset")
  tripId      String?          @map("trip_id") @db.Uuid
  orderId     String?          @map("order_id") @db.Uuid
  notes       String?
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  vessel      Vessel           @relation(fields: [vesselId], references: [id])

  @@index([vesselId, recordedAt])
  @@map("engine_hour_logs")
}

model MaintenanceOrder {
  id                String                  @id @default(uuid(7)) @db.Uuid
  orderNo           String                  @unique @map("order_no")
  vesselId          String                  @map("vessel_id") @db.Uuid
  planId            String?                 @map("plan_id") @db.Uuid
  title             String
  category          MaintCategory
  type              MaintType
  priority          Priority                @default(MEDIUM)
  status            MaintStatus             @default(OPEN)
  /// while IN_PROGRESS the vessel is set to MAINTENANCE
  takesOutOfService Boolean                 @default(false) @map("takes_out_of_service")
  reportedAt        DateTime                @map("reported_at") @db.Timestamptz
  startedAt         DateTime?               @map("started_at") @db.Timestamptz
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz
  engineHours       Decimal?                @map("engine_hours") @db.Decimal(10, 1)
  providerId        String?                 @map("provider_id") @db.Uuid
  invoiceNo         String?                 @map("invoice_no")
  description       String?
  findings          String?
  laborCost         Decimal                 @default(0) @map("labor_cost") @db.Decimal(14, 2)
  externalCost      Decimal                 @default(0) @map("external_cost") @db.Decimal(14, 2)
  /// sum of stock issued to this order (stock_movements ref MAINTENANCE)
  partsCost         Decimal                 @default(0) @map("parts_cost") @db.Decimal(14, 2)
  cancelReason      String?                 @map("cancel_reason")
  version           Int                     @default(1)
  createdById       String?                 @map("created_by_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  vessel            Vessel                  @relation(fields: [vesselId], references: [id])
  plan              MaintenancePlan?        @relation(fields: [planId], references: [id])
  provider          Supplier?               @relation(fields: [providerId], references: [id])
  attachments       MaintenanceAttachment[]

  @@index([vesselId, status])
  @@index([status])
  @@map("maintenance_orders")
}

model MaintenanceAttachment {
  id          String           @id @default(uuid(7)) @db.Uuid
  orderId     String           @map("order_id") @db.Uuid
  fileId      String           @map("file_id") @db.Uuid
  note        String?
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  order       MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("maintenance_attachments")
}
